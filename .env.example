# ---------------------------------------------------------------------------
# TrustLens AI — environment variable NAMES only. Never commit real values.
# Copy to .env.local for local development; set the same names in Vercel.
# ---------------------------------------------------------------------------

# --- Site origin (used to build the OAuth callback) ---
# Must match the Redirect URL configured in Supabase -> Authentication -> URL
# Configuration. Locally this is http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Database (optional: without it the app runs, but reports are not saved) ---
# The Vercel/Supabase integration injects both of these automatically.
# SUPABASE_URL is also accepted in place of NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses Row Level Security, so it must never be exposed
# to the browser and must never carry a NEXT_PUBLIC_ prefix.
# SUPABASE_SECRET_KEY is accepted as an alternative name.
SUPABASE_SERVICE_ROLE_KEY=

# --- Contextual analysis (optional: the app degrades honestly without it) ---
# Provide ONE of the following. AI_GATEWAY_API_KEY is preferred.
# Create a key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# Direct Anthropic alternative, used only if the gateway key is absent.
ANTHROPIC_API_KEY=
