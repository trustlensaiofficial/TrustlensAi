# Use your Supabase project's API URL and publishable key.
# Set these in Vercel Environment Variables for Preview and Production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Create a key in Vercel AI Gateway. Keep this server-side; never prefix it with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
